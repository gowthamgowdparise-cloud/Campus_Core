# ============================================================
# CAMPUSCORE - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
JSON_BODY_LIMIT=1mb
HTTP_REQUEST_TIMEOUT_MS=30000

# ── MongoDB ───────────────────────────────────────────────────
# Atlas Replica Set required for multi-document ACID transactions:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscore?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campuscore
MONGODB_URI_TEST=mongodb://localhost:27017/campuscore_test

# ── JWT ───────────────────────────────────────────────────────
# Generate 64-byte secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (REQUIRED in production; empty fails closed in prod)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── File Storage (Local for dev/test; S3 / S3-compatible for production) ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
MAX_FILE_SIZE_MB=10
STORAGE_SIGNED_URL_TTL_SECONDS=300
ALLOW_LOCAL_STORAGE_IN_PROD=false

# Required when STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Payment Gateway Integration (manual | razorpay | stripe) ─
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=INR

# Razorpay (required when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=http
LOG_DIR=logs

# ── Initial Admin Provisioning ────────────────────────────────
# Used ONLY by npm run seed:admin. Remove after first run.
INITIAL_ADMIN_EMAIL=admin@campuscore.edu
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
INITIAL_ADMIN_NAME=System Administrator
